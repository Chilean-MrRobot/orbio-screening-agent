# OpenAI
OPENAI_API_KEY=

# LangSmith (observabilidad, opcional)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=orbio-screening-agent
LANGSMITH_TRACING=false
# Cuentas de la región EU: https://eu.api.smith.langchain.com (la de EE.UU. da 403)
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# WhatsApp Cloud API (número de prueba)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Segundos sin mensajes nuevos antes de entregar el lote al agente
WHATSAPP_BATCH_SECONDS=8
WHATSAPP_GRAPH_VERSION=v23.0
# Número registrado en el número de prueba, para el test de integración (E.164)
WHATSAPP_TEST_RECIPIENT=

# Persistencia: memory (por defecto) o firestore
SCREENING_REPOSITORY=memory
FIRESTORE_PROJECT=
FIRESTORE_DATABASE=
# Solo para el emulador local (p. ej. localhost:8080); comentada, porque si existe la
# librería de Firestore se conecta al emulador en vez de a la base real.
# FIRESTORE_EMULATOR_HOST=localhost:8080

# Agrupación de mensajes con Cloud Tasks (spec 016)
# local (por defecto): la tarea corre en el proceso, solo para desarrollo. cloud: Cloud Tasks
TASKS_BACKEND=local
# Token en X-Task-Token para POST /tasks/process-inbound; obligatorio con cloud
# (en local, sin valor se genera uno al arrancar)
TASKS_TOKEN=
CLOUD_TASKS_PROJECT=gentle-app-313016
CLOUD_TASKS_LOCATION=europe-west1
CLOUD_TASKS_QUEUE=inbound-batches
# URL pública del servicio de Cloud Run, destino de las tareas
TASKS_SERVICE_URL=
# Opcional: cuenta de servicio para firmar un token OIDC en cada tarea
CLOUD_TASKS_SERVICE_ACCOUNT=

# Token que Cloud Scheduler envía en X-Task-Token a POST /tasks/reengagement (spec 011).
# Sin valor, la tarea de calentamiento queda deshabilitada (503).
REENGAGEMENT_TASK_TOKEN=

# Configuración de negocio (por defecto ./config)
SCREENING_CONFIG_DIR=config

# Panel de recruiters (specs 013 y 018, ver docs/crm.md)
# Una sola contraseña: entra al panel y es el bearer entre el panel y la API.
# Se define en ambos servicios; sin ella, la API no monta /crm y el panel no arranca.
PANEL_PASSWORD=
# URL de la API que lee el panel
PANEL_API_URL=http://localhost:8000
PANEL_REFRESH_SECONDS=5
# Filas por página de la tabla del panel
PANEL_PAGE_SIZE=25
# Fichas recientes sobre las que la API calcula la analítica (los totales cuentan todas)
PANEL_METRICS_WINDOW=1000

# Agente de voz en el navegador con ElevenLabs (spec 020). Solo en la API, nunca en el panel.
# Sin key, /voice responde 503 y la página de voz lo indica.
ELEVENLABS_API_KEY=
# Voz de Sofía (Laura, femenina y multilingüe); se puede cambiar por una nativa en español
ELEVENLABS_VOICE_ID=FGY2WhTYpPnrIDTdsKH5
# TTS multilingüe de menor latencia
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# Speech-to-Text (Scribe): detecta español o inglés
ELEVENLABS_STT_MODEL=scribe_v1
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_64
ELEVENLABS_TIMEOUT_SECONDS=30
# Límites de la grabación del candidato (la duración se mide en WAV)
VOICE_MAX_AUDIO_BYTES=5000000
VOICE_MAX_AUDIO_SECONDS=60

# Llamada en tiempo real con ElevenLabs Agents (spec 022). La key necesita el permiso
# "ElevenLabs Agents" (lectura y escritura). Orden de alta: ver specs/022-llamada-tiempo-real.md.
# Bearer que ElevenLabs envía a POST /voice/llm/v1/chat/completions (Custom LLM). Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
VOICE_LLM_SECRET=
# Lo imprime deploy/elevenlabs_agent.py. Sin él, /voice/call responde 503.
ELEVENLABS_AGENT_ID=
# Segundos antes de decir la frase de espera (plantilla voice_wait); 0 la desactiva
VOICE_WAIT_AFTER_SECONDS=1.5
# Cuánto espera un turno si el anterior todavía tiene el lease (interrupciones)
VOICE_BUSY_WAIT_SECONDS=8
